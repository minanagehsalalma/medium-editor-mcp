MEDIUM_ACCESS_TOKEN=your_medium_integration_token

# Optional: required only for legacy Medium OAuth flows that already have
# a registered integration. Medium does not allow new browser-based apps.
MEDIUM_CLIENT_ID=
MEDIUM_CLIENT_SECRET=
MEDIUM_AUTH_CODE=
MEDIUM_REDIRECT_URI=http://localhost:3000/callback

# Optional: enables secret/private gist imports and raises rate limits.
GITHUB_TOKEN=

# Medium session-based automation. Required for private GraphQL/editor actions.
# Easiest path: run setup-medium-session once and let it write MEDIUM_COOKIES_FILE for you.
# Accepted cookie source formats in the tooling:
# - browser-exported JSON arrays
# - JSON objects with a cookies array
# - raw Cookie headers such as "sid=...; uid=...; xsrf=..."
# - Netscape cookie files from browser-export extensions
MEDIUM_COOKIES_FILE=
MEDIUM_COOKIES_JSON=
MEDIUM_COOKIE_HEADER=

# Medium private GraphQL settings.
MEDIUM_GRAPHQL_ENDPOINT=https://medium.com/_/graphql
MEDIUM_GRAPHQL_SOURCE=codex-medium-mcp
MEDIUM_GRAPHQL_REFERER=https://medium.com/me/stories/drafts
MEDIUM_GRAPHQL_OPERATIONS_FILE=
MEDIUM_GRAPHQL_USER_AGENT=
MEDIUM_GRAPHQL_TRANSPORT=
MEDIUM_CYCLETLS_SCRIPT=

# Browser-backed editor automation. Use one of these:
# 1. MEDIUM_CDP_ENDPOINT for an existing signed-in Chrome launched with remote debugging
# 2. MEDIUM_COOKIES_FILE pointing at a local exported cookie JSON file
# 3. MEDIUM_COOKIES_JSON containing the cookie array inline
MEDIUM_CDP_ENDPOINT=
MEDIUM_BROWSER_HEADLESS=false
MEDIUM_BROWSER_CHANNEL=chrome

# Optional: exposes legacy/undocumented Medium tools that are disabled by default.
MEDIUM_ENABLE_EXPERIMENTAL_TOOLS=false
